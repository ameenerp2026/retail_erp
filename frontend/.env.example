# Copy to `.env.local` and adjust.

# true  → services return data from `src/mocks` (default in DEV)
# false → services call the real API at VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Backend origin (no trailing slash required)
VITE_API_BASE_URL=http://localhost:5000

# Artificial delay for mock responses (ms). Set 0 to disable.
VITE_MOCK_DELAY_MS=200
