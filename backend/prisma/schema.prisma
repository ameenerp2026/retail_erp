generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "user", "organization", "finance"]
}

model User {
  id                     Int              @id @default(autoincrement())
  name                   String
  email                  String           @unique
  createdAt              DateTime         @default(now())
  password               String
  role                   Roles            @default(EMPLOYEE)
  createdAccountingYears AccountingYear[] @relation("CreatedAccountingYears")
  updatedAccountingYears AccountingYear[] @relation("UpdatedAccountingYears")
  createdGSTINs GSTIN[]  @relation("UserCreatedGSTINs")

  @@schema("user")
}

enum Roles {
  ADMIN
  EMPLOYEE

  @@schema("user")
}

model OrganizationGroup {
  id Int @id @default(autoincrement())

  shortName     String
  logoUrl       String?
  financialYear String
  currency      String

  companyName String
  cinNumber   String
  panNumber   String
  email       String
  phoneNumber String
  website     String?
  address     String

  state   String
  country String
  pinCode String

  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    organizationUnits OrganizationUnit[]


  @@schema("organization")
}

model OrganizationUnit {
  id               Int      @id @default(autoincrement())
  organizationUnit String
  unitType         String
  gstIn            String
  manager          String
  organizationGroupId Int

   organizationGroup OrganizationGroup @relation(fields: [organizationGroupId],references: [id])

  state             String
  address           String
  status            String   @default("Active")
  gstins            GSTIN[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
businessLocations BusinessLocation[]
  @@schema("organization")
}

model AccountingYear {
  id       Int        @id @default(autoincrement())
  fromDate DateTime
  toDate   DateTime
  yearName String
  status   YearStatus @default(OPEN)

  financeMonths FinanceMonth[]
  createdById   Int
  createdBy     User           @relation("CreatedAccountingYears", fields: [createdById], references: [id])

  updatedById Int?
  updatedBy   User? @relation("UpdatedAccountingYears", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("organization")
}

enum YearStatus {
  OPEN
  CLOSED

  @@schema("organization")
}

model FinanceMonth {
  id Int @id @default(autoincrement())

  period        String
  startDate     DateTime
  endDate       DateTime
  financeStatus FinanceStatus @default(Open)

  accountingYearId Int
  accountingYear   AccountingYear @relation(fields: [accountingYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("organization")
}
enum FinanceStatus {
  Open
  Closed
  Provisional

  @@schema("organization")
}



model GSTIN {
  id                  Int      @id @default(autoincrement())

  gstin               String   @unique

  state               String

 organizationUnitId  Int
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id])
       
  registrationType    RegistrationType

  status GSTINStatus @default(PENDING)
  createdById         Int
  createdBy          User @relation("UserCreatedGSTINs", fields: [createdById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  businessLocations   BusinessLocation[]

  @@schema("organization")
}


enum RegistrationType {
  REGULAR
  COMPOSITION
  SEZ
   @@schema("organization")

}

enum GSTINStatus {
  VERIFIED
  FAILED
  PENDING

  @@schema("organization")
}

model BusinessLocation {
  id Int @id @default(autoincrement())

  // BASIC INFORMATION
  locationName String
  locationCode String @unique

  parentOrganizationUnitId Int
  parentOrganizationUnit OrganizationUnit @relation(fields: [parentOrganizationUnitId],references: [id])

  locationType LocationType
  businessCategory BusinessCategory

  // ADDRESS
  addressLine1 String
  addressLine2 String?
  landmark String?
  city String
  state String
  country String
  pinCode String

  // CONTACT
  contactPerson String
  phoneNumber String?
  email String?
  emergencyContact String?

  // GST
  linkedGSTINId Int
  linkedGSTIN GSTIN @relation(fields: [linkedGSTINId],references: [id])

  registrationType RegistrationType

  // DEFAULT LOCATIONS
  defaultBillingLocation Boolean @default(false)
  defaultStockLocation Boolean @default(false)

  // OPERATIONAL SETTINGS
  allowSales Boolean @default(false)
  allowPurchase Boolean @default(false)
  allowInventory Boolean @default(false)
  allowDispatch Boolean @default(false)
  allowPOS Boolean @default(false)

  //defaultWarehouseId Int?
  //parentWarehouseId Int?

  // STATUS
  status LocationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("organization")
}

enum LocationType {
  HEAD_OFFICE
  BRANCH
  WAREHOUSE
  STORE

  @@schema("organization")
}

enum BusinessCategory {
  RETAIL
  WHOLESALE
  DISTRIBUTION
  MANUFACTURING
  
  @@schema("organization")
}

enum LocationStatus {
  ACTIVE
  INACTIVE

  @@schema("organization")
}

model GSTMangement {
  id               Int       @id @default(autoincrement())
  gstin            String    @unique
  state            String
  organizationUnit String
  type             GstType
  status           GstStatus

  lastVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("organization")
}

enum GstType {
  REGULAR
  COMPOSITION
  SEZ
  @@schema("organization")
}

enum GstStatus {
  VERIFIED
  PENDING
  FAILED

  @@schema("organization")
}
